{
  "Comment": "Semaphor Export Processor - Parallel chunk processing with compaction v2",
  "StartAt": "ChooseAcquisition",
  "States": {
    "ChooseAcquisition": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.acquisition", "IsPresent": true, "Next": "ValidateContinuation" }],
      "Default": "ProcessChunks"
    },
    "ValidateContinuation": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.acquisition", "StringEquals": "continuation", "Next": "ValidateMatrixDeadline" }],
      "Default": "InvalidAcquisition"
    },
    "InvalidAcquisition": { "Type": "Fail", "Error": "InvalidExportAcquisition" },
    "ValidateMatrixDeadline": {
      "Type": "Choice",
      "Choices": [{ "And": [
        { "Variable": "$.deadlineAt", "IsPresent": true },
        { "Variable": "$.deadlineAt", "IsNumeric": true },
        { "Variable": "$.deadlineAt", "NumericGreaterThan": 0 }
      ], "Next": "ResetMatrixBatchRetry" }],
      "Default": "InvalidMatrixDeadline"
    },
    "InvalidMatrixDeadline": {
      "Type": "Pass",
      "Result": { "Error": "ExportQueryRejectedError", "Cause": "Matrix continuation deadlineAt is required." },
      "ResultPath": "$.error",
      "Next": "MarkExportFailed"
    },
    "ProcessMatrixBatch": {
      "Type": "Task", "Resource": "${ChunkProcessorArn}",
      "Parameters": { "acquisition": "continuation", "jobId.$": "$.jobId", "sequence.$": "$.continuation.sequence", "deadlineAt.$": "$.deadlineAt" },
      "ResultPath": "$.continuation",
      "Catch": [
        { "ErrorEquals": ["ExportQueryRejectedError"], "Next": "MarkExportFailed", "ResultPath": "$.error" },
        { "ErrorEquals": ["States.ALL"], "Next": "CanRetryMatrix", "ResultPath": "$.error" }
      ],
      "Next": "MatrixExhausted"
    },
    "MatrixExhausted": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.continuation.done", "BooleanEquals": true, "Next": "ResetMatrixFinalizationRetry" }],
      "Default": "ResetMatrixBatchRetry"
    },
    "ResetMatrixBatchRetry": {
      "Type": "Pass", "Result": { "count": 0, "phase": "batch", "replayOnly": false },
      "ResultPath": "$.matrixRetry", "Next": "DispatchMatrixAttempt"
    },
    "ResetMatrixFinalizationRetry": {
      "Type": "Pass", "Result": { "count": 0, "phase": "finalization", "replayOnly": false },
      "ResultPath": "$.matrixRetry", "Next": "DispatchMatrixAttempt"
    },
    "DispatchMatrixAttempt": {
      "Type": "Choice", "QueryLanguage": "JSONata",
      "Choices": [
        { "Condition": "{% $states.input.matrixRetry.phase = 'batch' and $states.input.deadlineAt <= $millis() %}", "Next": "ResetMatrixFinalizationRetry" },
        { "Condition": "{% $states.input.matrixRetry.phase = 'batch' %}", "Next": "ProcessMatrixBatch" }
      ],
      "Default": "StampMatrixFinalizationAttempt"
    },
    "StampMatrixFinalizationAttempt": {
      "Type": "Pass", "QueryLanguage": "JSONata",
      "Output": "{% $merge([$states.input, {'matrixRetry': $merge([$states.input.matrixRetry, {'replayOnly': $states.input.deadlineAt <= $millis()}])}]) %}",
      "Next": "CompactMatrixAndNotify"
    },
    "CanRetryMatrix": {
      "Type": "Choice", "QueryLanguage": "JSONata",
      "Choices": [{ "Condition": "{% $states.input.matrixRetry.count < 3 and $not($states.input.matrixRetry.replayOnly) %}", "Next": "WaitMatrixRetry" }],
      "Default": "MarkExportFailed"
    },
    "WaitMatrixRetry": {
      "Type": "Wait", "QueryLanguage": "JSONata",
      "Timestamp": "{% $fromMillis($min([$states.input.deadlineAt, $millis() + 5000 * $power(2, $states.input.matrixRetry.count)])) %}",
      "Next": "IncrementMatrixRetry"
    },
    "IncrementMatrixRetry": {
      "Type": "Pass", "QueryLanguage": "JSONata",
      "Output": "{% $merge([$states.input, {'matrixRetry': $merge([$states.input.matrixRetry, {'count': $states.input.matrixRetry.count + 1}])}]) %}",
      "Next": "DispatchMatrixAttempt"
    },
    "ProcessChunks": {
      "Type": "Map",
      "ItemsPath": "$.chunks",
      "MaxConcurrency": 40,
      "Parameters": {
        "chunkId.$": "$$.Map.Item.Value.chunkId",
        "chunkNumber.$": "$$.Map.Item.Value.chunkNumber",
        "chunkSize.$": "$$.Map.Item.Value.chunkSize",
        "isFirstChunk.$": "$$.Map.Item.Value.isFirstChunk",
        "jobId.$": "$.jobId",
        "exportToken.$": "$.exportToken",
        "cardConfig.$": "$.cardConfig",
        "formatting.$": "$.formatting",
        "tableTotalsRequest.$": "$$.Map.Item.Value.tableTotalsRequest"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "ProcessSingleChunk",
        "States": {
          "ProcessSingleChunk": {
            "Type": "Task",
            "Resource": "${ChunkProcessorArn}",
            "Retry": [
              {
                "ErrorEquals": ["ExportQueryRejectedError"],
                "MaxAttempts": 0
              },
              {
                "ErrorEquals": ["States.ALL"],
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "IntervalSeconds": 5
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.chunkResults",
      "Next": "CompactAndNotify",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "MarkExportFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CompactAndNotify": {
      "Type": "Task",
      "Resource": "${CompactionProcessorArn}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "MarkExportFailed",
          "ResultPath": "$.error"
        }
      ],
      "End": true
    },
    "CompactMatrixAndNotify": {
      "Type": "Task", "Resource": "${CompactionProcessorArn}",
      "Parameters": { "acquisition": "continuation", "jobId.$": "$.jobId", "deadlineAt.$": "$.deadlineAt" },
      "Catch": [
        { "ErrorEquals": ["ExportQueryRejectedError"], "Next": "MarkExportFailed", "ResultPath": "$.error" },
        { "ErrorEquals": ["States.ALL"], "Next": "CanRetryMatrix", "ResultPath": "$.error" }
      ],
      "End": true
    },
    "MarkExportFailed": {
      "Type": "Task",
      "Resource": "${MarkFailedArn}",
      "End": true
    }
  }
}
