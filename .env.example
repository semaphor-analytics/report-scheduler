# Configuration for Semaphor Report Scheduler
# Copy this file to .env and update with your actual values

# Base URL for your Semaphor application (no trailing slash)
SEMAPHOR_APP_URL=https://your-semaphor-instance.com

# API key for Lambda functions to authenticate with Semaphor backend
# Generate a secure key with: openssl rand -hex 32
# This same key must also be set as LAMBDA_API_KEY in your semaphor-app .env
LAMBDA_API_KEY=your-api-key-here

# SES verified sender email address for sending reports
# This email must be verified in AWS SES before use
# Example: noreply@yourdomain.com or "Your Company <noreply@yourdomain.com>"
SES_SENDER_EMAIL=noreply@yourdomain.com

# Email delivery mode: SES (default) or EXTERNAL
EMAIL_PROVIDER_MODE=SES

# When false, sends to first resolved recipient only (legacy behavior)
# When true, sends to all resolved recipients
EMAIL_ENABLE_MULTI_RECIPIENTS=false

# SES region used by the email sender Lambda
SES_REGION=us-east-1

# Shared secret for EmailSender -> external provider request signing
# Required when EMAIL_PROVIDER_MODE=EXTERNAL
EMAIL_EXTERNAL_AUTH_SECRET=

# Same-stack Resend provider Lambda configuration
RESEND_API_KEY=
RESEND_SENDER_EMAIL=reports@yourdomain.com
